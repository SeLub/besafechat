# Backend Configuration
# Copy this file to .env and fill in the values

# Server Port
PORT=4000

# Node Environment (development, production, test)
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=besafechat_db

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# CORS Origins - Comma-separated list of allowed frontend URLs
# Examples:
#   Development (localhost):
#     CORS_ORIGINS=http://localhost:3000,http://localhost:5173
#   Local Network (accessing from other devices):
#     CORS_ORIGINS=http://localhost:5173,http://192.168.100.35:5173
#   Production:
#     CORS_ORIGINS=https://besafechat.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=1800

# Password Recovery
PASSWORD_RECOVERY_SECRET=your-password-recovery-secret

# S3 / Cloudflare R2 Storage
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false
# Cloudflare Worker URL for public avatar access (keeps bucket private)
S3_AVATAR_URL=https://avatar.yourname.workers.dev

# Swagger/OpenAPI
SWAGGER_ENABLED=true
